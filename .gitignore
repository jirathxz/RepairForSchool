# Environment Settings (Do not commit secrets)
.env

# Composer Dependencies (Can be regenerated with composer dump-autoload)
/vendor/

# User Uploaded Media (Preserve folders with .gitkeep)
/uploads/before/*
!/uploads/before/.gitkeep
/uploads/after/*
!/uploads/after/.gitkeep

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# Editor & IDE Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs & Temporary Files
*.log
*.tmp
*.bak
